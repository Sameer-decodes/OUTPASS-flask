# Flask Application Settings
PORT=5000
SECRET_KEY=your_super_secret_flask_key_change_in_production
JWT_SECRET_KEY=your_jwt_signing_key_change_in_production
JWT_EXPIRATION_HOURS=24

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=college_outpass_db

# Optional direct database URL override
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/college_outpass_db
